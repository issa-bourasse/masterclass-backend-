# Server Port
PORT=3001

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Neon Database
# Get this from https://neon.tech/dashboard
DATABASE_URL=postgres://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# GetStream.io
# Get these from https://getstream.io/dashboard
STREAM_API_KEY=your_api_key
STREAM_API_SECRET=your_api_secret

# Clerk Webhook Secret
# Get this from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET=whsec_xxx
